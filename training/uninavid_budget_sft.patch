+class ForceLRCallback(transformers.TrainerCallback):
+    """[budget-SFT v2] Version-skew-proof training guarantees:
+    - LR written through EVERY optimizer wrapper layer (deepspeed wraps HF's);
+    - parameter-motion probe: prints the L2 drift of a trainable projector param
+      (ground truth that gradient steps are actually applied)."""
+    def __init__(self, base_lr, warmup_ratio=0.03):
+        self.base_lr = base_lr; self.warmup_ratio = warmup_ratio; self.ref = None; self.pname = None
+    def _set_lr(self, opt, lr):
+        seen = set()
+        while opt is not None and id(opt) not in seen:
+            seen.add(id(opt))
+            if hasattr(opt, 'param_groups'):
+                for g in opt.param_groups:
+                    g['lr'] = lr
+            opt = getattr(opt, 'optimizer', None)
+    def on_step_begin(self, args, state, control, **kw):
+        import math as _m
+        total = max(1, state.max_steps)
+        warm = max(1, int(self.warmup_ratio * total))
+        step = state.global_step
+        lr = self.base_lr * (step + 1) / warm if step < warm else              0.5 * self.base_lr * (1 + _m.cos(_m.pi * (step - warm) / max(1, total - warm)))
+        self._set_lr(kw.get('optimizer'), lr)
+        model = kw.get('model')
+        if model is not None and self.ref is None:
+            for n, p in model.named_parameters():
+                if 'mm_projector' in n and p.requires_grad:
+                    self.pname = n; self.ref = p.detach().float().clone(); break
+        if step % 5 == 0 and state.is_world_process_zero:
+            drift = -1.0
+            if model is not None and self.ref is not None:
+                for n, p in model.named_parameters():
+                    if n == self.pname:
+                        drift = (p.detach().float() - self.ref).norm().item(); break
+            print(f"FORCED_LR={lr:.3e} step={step} PARAM_DRIFT={drift:.3e}", flush=True)
+
+
 def train():
     global local_rank
 
